{
  "name": "@dettalia/design-system",
  "version": "0.1.0",
  "description": "Bliro's cross-platform design system for React Native and React Native Web.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dettalia/code-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "tokens:build": "style-dictionary build --config style-dictionary/sd.config.mjs",
    "build": "npm run tokens:build && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "jest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/eslint-config": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@react-native/typescript-config": "^0.87.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-react-native-web": "^0.0.29",
    "@storybook/react": "^10.6.0",
    "@storybook/react-webpack5": "^10.6.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-react-native-web": "^0.21.2",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-web": "^0.21.2",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.5",
    "test-renderer": "^1.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
